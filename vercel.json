{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "dist": "dist"
      }
    },
    {
      "src": "requirements.txt",
      "use": "@vercel/python"
    }
  ],
  "functions": {
    "api/main.py": {
      "maxDuration": 30,
      "includeFiles": "src/**/*.py|data/generated/*.json|alembic/**/*.py|requirements.txt"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" }
  ]
}
