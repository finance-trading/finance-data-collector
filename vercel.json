{
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "dist": "frontend/dist"
      }
    },
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "src/**/*.py|data/generated/*.json|alembic/**/*.py|requirements.txt"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" }
  ]
}
