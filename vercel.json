{
  "builds": [
    {
      "src": "vercel-static-build.sh",
      "use": "@vercel/static-build",
      "config": {
        "buildCommand": "bash vercel-static-build.sh",
        "outputDirectory": "frontend/static-dist"
      }
    },
    {
      "src": "api/main.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": "src/**/*.py|data/generated/*.json|alembic/**/*.py|requirements.txt|config/*.json"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/main.py" }
  ]
}
