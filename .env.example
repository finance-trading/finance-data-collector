# Required for all SEC API requests. Include a contact email per SEC guidance.
FDC_SEC_USER_AGENT=FinanceDataCollector/0.1 contact@example.com

FDC_DATABASE_URL=postgresql+psycopg://fdc:fdc@localhost:5432/fdc
FDC_RAW_ROOT=./data/raw
FDC_SEC_TIMEOUT_SECONDS=30
FDC_PARSE_TIMEOUT_SECONDS=300
FDC_RETRY_MAX_ATTEMPTS=3
FDC_RETRY_BASE_DELAY_SECONDS=1
FDC_RETRY_MAX_DELAY_SECONDS=30

# Local archive of downloaded filing packages (sec/<TICKER>/<FORM>/<ACCESSION>).
FDC_SEC_ROOT=./sec
# Bumped whenever parser behavior changes so re-parses create new versions.
FDC_PARSER_VERSION=filing-parser-v1

# Open research-annotation write API key. Leave unset to keep writes local-only.
# FDC_API_KEY=


SUPABASE=zAZwwGUhltRyDeeG
SUPAASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.fusehtxlcyseuuuzhfpo.supabase.co:5432/postgres
