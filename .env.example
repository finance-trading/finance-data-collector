# Required for all SEC API requests. Include a contact email per SEC guidance.
FDC_SEC_USER_AGENT=FinanceDataCollector/0.1 contact@example.com

FDC_DATABASE_URL=postgresql+psycopg://fdc:fdc@localhost:5432/fdc
FDC_RAW_ROOT=./data/raw
FDC_SEC_TIMEOUT_SECONDS=30
FDC_RETRY_MAX_ATTEMPTS=3
FDC_RETRY_BASE_DELAY_SECONDS=1
FDC_RETRY_MAX_DELAY_SECONDS=30
