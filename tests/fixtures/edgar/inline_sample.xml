<?xml version="1.0" encoding="UTF-8"?>
<html
  xmlns="http://www.w3.org/1999/xhtml"
  xmlns:ix="http://www.xbrl.org/2013/inlineXBRL"
  xmlns:ix11="http://www.xbrl.org/2013/inlineXBRL"
  xmlns:xbrli="http://www.xbrl.org/2003/instance"
  xmlns:xbrldi="http://xbrl.org/2006/xbrldi"
  xmlns:us-gaap="http://fasb.org/us-gaap/2024"
  xmlns:dei="http://xbrl.sec.gov/dei/2024"
  xmlns:acme="http://www.acme.example/20240331"
  xmlns:iso4217="http://www.xbrl.org/2003/iso4217">
  <head>
    <title>ACME inline XBRL sample</title>
    <ix:header>
      <ix:hidden>
        <ix:nonNumeric name="dei:DocumentType" contextRef="c-q1">10-Q</ix:nonNumeric>
      </ix:hidden>
      <ix:resources>
        <xbrli:context id="c-q1">
          <xbrli:entity>
            <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier>
          </xbrli:entity>
          <xbrli:period>
            <xbrli:startDate>2024-01-01</xbrli:startDate>
            <xbrli:endDate>2024-03-31</xbrli:endDate>
          </xbrli:period>
        </xbrli:context>
        <xbrli:context id="c-instant">
          <xbrli:entity>
            <xbrli:identifier scheme="http://www.sec.gov/CIK">0000000001</xbrli:identifier>
          </xbrli:entity>
          <xbrli:period><xbrli:instant>2024-03-31</xbrli:instant></xbrli:period>
        </xbrli:context>
        <xbrli:unit id="U_USD"><xbrli:measure>iso4217:USD</xbrli:measure></xbrli:unit>
      </ix:resources>
    </ix:header>
  </head>
  <body>
    <p>
      Revenue for the quarter was
      <ix:nonFraction name="us-gaap:Revenues" contextRef="c-q1" unitRef="U_USD" decimals="-6" scale="6">69,632</ix:nonFraction>
      millions of dollars.
    </p>
    <p>
      Total assets were
      <ix:nonFraction name="us-gaap:Assets" contextRef="c-instant" unitRef="U_USD" decimals="-6" scale="6">484,275</ix:nonFraction>
      millions of dollars.
    </p>
    <p>
      Net loss of
      <ix:nonFraction name="us-gaap:NetIncomeLoss" contextRef="c-q1" unitRef="U_USD" decimals="-6" scale="6" sign="-">1,234</ix:nonFraction>
      was recorded.
    </p>
  </body>
</html>
